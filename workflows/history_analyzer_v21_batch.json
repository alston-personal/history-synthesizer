            "typeVersion": 4.1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const results = ($input.item.json.organic_results || []).concat($input.item.json.news_results || []);\nconst allText = results.slice(0, 10).map((r, i) => `Source ${i+1}: ${r.title}. ${r.snippet || ''}`).join('\\n\\n');\nreturn { json: { allText, results } };"
            },
            "id": "aggregate_snippets",
            "name": "Aggregate Snippets",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
